#!/bin/sh
set -e

GREEN='\033[0;32m'
RESET='\033[0m'
ok() { printf "${GREEN}%s${RESET}\n" "$1"; }

run_parallel() {
  label="$1"
  out=$(mktemp)
  shift
  ( "$@" >"$out" 2>&1 ) &
  pid=$!
  eval "pid_$label=$pid"
  eval "out_$label=$out"
}

wait_step() {
  label="$1"
  eval "pid=\$pid_$label"
  eval "out=\$out_$label"
  if wait "$pid"; then
    rm -f "$out"
    ok "✔ $label passed"
  else
    status=$?
    echo "------ $label failed ------"
    cat "$out"
    rm -f "$out"
    exit $status
  fi
}

echo '------ Running pre-push hooks ------'

protected_branch="main"
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/$protected_branch" ]; then
    echo "pre-push: direct push to '$protected_branch' is blocked. Open a PR instead." >&2
    exit 1
  fi
done

run_parallel Lint npm run lint
run_parallel Coverage npm run test:coverage
run_parallel Audit npm audit

wait_step Lint
wait_step Coverage
wait_step Audit

ok '✔ pre-push: all checks passed'
